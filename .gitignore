# Dependencies
node_modules/

# Build outputs
dist/
release/
build/
out/

# electron-builder needs the application icons from this folder
!desktop-app/build/
!desktop-app/build/**

# Reference templates and audit evidence (kept locally, excluded from the repository)
*.xlsx
!desktop-app/tests/fixtures/*.xlsx
تدقيق-شامل/
نتائج-الفحص/
screenshot-*.png
desktop-app/screenshot-*.png
desktop-app/*-result.json
desktop-app/*-stdout.txt
desktop-app/*-log.txt
desktop-app/tools/*-result.json

# Local logs and temporary evidence
*.log
*.err.log
.verdent/
_cache/

# Local databases and secrets
*.db
*.db-journal
*.db-wal
store.key

# Backup and key material must never be committed (encrypted originals kept by
# the plaintext conversion, plaintext/encrypted backup bundles and their keys)
*.bak
*.bak.key
*.encrypted-*.bak*

# OS noise
Thumbs.db
desktop.ini
.verdent/lr/
