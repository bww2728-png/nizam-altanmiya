{
  "name": "local-development-intelligence",
  "version": "0.6.0",
  "private": true,
  "description": "نظام محلي لإدارة بيانات التنمية والتحليل القطاعي",
  "author": "Local Development Intelligence",
  "main": "src/main/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start:desktop": "electron .",
    "dev:desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev-server=http://127.0.0.1:5173\"",
    "build": "vite build",
    "test": "node --test",
    "prepare:win": "npm install --no-save --ignore-scripts --include=optional --os=win32 --cpu=x64",
    "dist:win": "npm run build && npm run prepare:win && electron-builder --win nsis --x64",
    "dist:win:dir": "npm run build && npm run prepare:win && electron-builder --win dir --x64",
    "dist:win:zip": "npm run build && npm run prepare:win && electron-builder --win zip --x64"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "electron-updater": "^6.8.11",
    "exceljs": "4.4.0",
    "unzipper": "0.12.5",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "vite": "8.3.6",
    "wait-on": "^8.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "build": {
    "appId": "org.local.development-intelligence",
    "compression": "maximum",
    "productName": "نظام التنمية المحلية",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "bww2728-png",
        "repo": "nizam-altanmiya",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3-multiple-ciphers/**"
    ],
    "files": [
      "dist/**",
      "src/main/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "services/document_worker",
        "to": "document-worker",
        "filter": ["worker.py"]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "Local-Development-Intelligence-${version}-${arch}.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "نظام التنمية المحلية"
    }
  }
}
